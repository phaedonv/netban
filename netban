#!/usr/bin/env bash
# netban — manual IPv4 network bans with nftables (temporary or permanent).
#
#   netban                              interactive prompt
#   netban 203.0.113.0/24 [6h]          temporary ban (default 24h)
#   netban 203.0.113.0/24 perm [note]   permanent ban, survives reboot
#   netban 203.0.113.57/24              host bits masked -> 203.0.113.0/24
#   netban -l                           list bans, time left, drop counters
#   netban -u 203.0.113.0/24            unban (temporary and permanent)
#   netban restore                      reload permanent bans (used at boot)
#   netban --install                    install to /usr/local/bin + boot service
#   netban --purge                      remove runtime bans and the nft table
#
# Own nft table (inet netban) at priority -10: does not touch UFW,
# firewalld or other rules. See README.md.
#
# Author:  phaedonv — Catalink Limited (https://catalink.eu)
# Source:  https://github.com/phaedonv/netban
# License: MIT

set -uo pipefail

TABLE="inet netban"
TMP_SET="temp"
PERM_SET="perm"
STATE_DIR="/etc/netban"
PERM_FILE="$STATE_DIR/permanent.list"
UNIT_FILE="/etc/systemd/system/netban.service"
DEFAULT_DUR="24h"

[[ $EUID -ne 0 ]] && exec sudo "$0" "$@"
command -v nft >/dev/null || { echo "nft not found (install the nftables package)"; exit 1; }

# ---------------------------------------------------------------- nft setup
ensure() {
  nft list table $TABLE >/dev/null 2>&1 || nft add table $TABLE
  nft list set $TABLE $TMP_SET >/dev/null 2>&1 ||
    nft "add set $TABLE $TMP_SET { type ipv4_addr; flags interval, timeout; }"
  nft list set $TABLE $PERM_SET >/dev/null 2>&1 ||
    nft "add set $TABLE $PERM_SET { type ipv4_addr; flags interval; }"
  nft list chain $TABLE input >/dev/null 2>&1 ||
    nft "add chain $TABLE input { type filter hook input priority -10; policy accept; }"
  local rules
  rules=$(nft list chain $TABLE input)
  grep -q "@$PERM_SET" <<<"$rules" || nft add rule $TABLE input ip saddr @$PERM_SET counter drop
  grep -q "@$TMP_SET" <<<"$rules" || nft add rule $TABLE input ip saddr @$TMP_SET counter drop
}

# ------------------------------------------------- validate + mask an IPv4/CIDR
normalize() {
  local in="$1" ip prefix a b c d
  [[ $in =~ ^([0-9]{1,3}(\.[0-9]{1,3}){3})(/([0-9]{1,2}))?$ ]] || return 1
  ip=${BASH_REMATCH[1]}
  prefix=$((10#${BASH_REMATCH[4]:-32}))
  ((prefix <= 32)) || return 1
  IFS=. read -r a b c d <<<"$ip"
  a=$((10#$a)); b=$((10#$b)); c=$((10#$c)); d=$((10#$d))
  ((a <= 255 && b <= 255 && c <= 255 && d <= 255)) || return 1
  local n=$(((a << 24) | (b << 16) | (c << 8) | d))
  local mask=$((prefix == 0 ? 0 : (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF))
  n=$((n & mask))
  local out="$(((n >> 24) & 255)).$(((n >> 16) & 255)).$(((n >> 8) & 255)).$((n & 255))"
  if ((prefix == 32)); then echo "$out"; else echo "$out/$prefix"; fi
}

# ------------------------------------------------------ permanent list file
perm_file_init() {
  mkdir -p "$STATE_DIR"
  [[ -f $PERM_FILE ]] || printf '%s\n' \
    "# netban permanent bans — managed by netban, restored at boot by netban.service" \
    "# format: <network>  # added <date> [- note]" >"$PERM_FILE"
}
perm_file_has() { [[ -f $PERM_FILE ]] && awk -v n="$1" '$1==n{f=1} END{exit !f}' "$PERM_FILE"; }
perm_file_add() {
  perm_file_init
  perm_file_has "$1" && return 0
  echo "$1  # added $(date +%F)${2:+ - $2}" >>"$PERM_FILE"
}
perm_file_del() {
  [[ -f $PERM_FILE ]] || return 0
  local t
  t=$(mktemp)
  awk -v n="$1" '$1!=n' "$PERM_FILE" >"$t" && cat "$t" >"$PERM_FILE"
  rm -f "$t"
}

# ----------------------------------------------------------------- actions
ban() {
  local net dur="${2:-$DEFAULT_DUR}" note="${3:-}"
  net=$(normalize "${1:-}") || { echo "invalid network: ${1:-<empty>}"; return 1; }
  ensure
  case $dur in
    perm|permanent)
      nft delete element $TABLE $TMP_SET "{ $net }" 2>/dev/null
      nft add element $TABLE $PERM_SET "{ $net }" || return 1
      perm_file_add "$net" "$note"
      echo "banned $net permanently"
      ;;
    *)
      [[ $dur =~ ^([0-9]+[dhms])+$ ]] ||
        { echo "invalid duration: $dur (e.g. 30m, 6h, 1d, 2d12h, perm)"; return 1; }
      # delete first so re-banning refreshes the timer
      nft delete element $TABLE $TMP_SET "{ $net }" 2>/dev/null
      nft add element $TABLE $TMP_SET "{ $net timeout $dur }" && echo "banned $net for $dur"
      ;;
  esac
}

unban() {
  local net hit=0
  net=$(normalize "${1:-}") || { echo "invalid network: ${1:-<empty>}"; return 1; }
  if nft delete element $TABLE $TMP_SET "{ $net }" 2>/dev/null; then
    echo "removed temporary ban $net"; hit=1
  fi
  if nft delete element $TABLE $PERM_SET "{ $net }" 2>/dev/null || perm_file_has "$net"; then
    perm_file_del "$net"; echo "removed permanent ban $net"; hit=1
  fi
  ((hit)) || echo "$net not found (must match exactly as shown by netban -l)"
}

show_set() {
  nft list set $TABLE "$1" 2>/dev/null |
    awk '/elements/{p=1} p{print} p&&/}/{exit} END{if(!p) print "  (none)"}'
}

list() {
  if ! nft list table $TABLE >/dev/null 2>&1; then echo "no bans active"; return; fi
  echo "--- temporary ---"
  show_set $TMP_SET
  echo "--- permanent (live) ---"
  show_set $PERM_SET
  if [[ -f $PERM_FILE ]]; then
    echo "--- permanent ($PERM_FILE) ---"
    grep -Ev '^[[:space:]]*(#|$)' "$PERM_FILE" || echo "  (none)"
  fi
  echo "--- drops ---"
  nft list chain $TABLE input | grep -o '@[a-z]* counter packets [0-9]* bytes [0-9]*'
}

restore() {
  ensure
  nft flush set $TABLE $PERM_SET
  [[ -f $PERM_FILE ]] || { echo "no permanent list ($PERM_FILE)"; return 0; }
  local raw net n=0
  while read -r raw _; do
    [[ -z $raw || $raw == \#* ]] && continue
    net=$(normalize "$raw") || { echo "skipping invalid entry: $raw"; continue; }
    nft add element $TABLE $PERM_SET "{ $net }" && n=$((n + 1))
  done <"$PERM_FILE"
  echo "restored $n permanent ban(s)"
}

purge() {
  if nft delete table $TABLE 2>/dev/null; then
    echo "runtime bans removed"
  else
    echo "nothing active to remove"
  fi
  [[ -f $PERM_FILE ]] && echo "note: $PERM_FILE is kept; permanent bans return on 'netban restore' or reboot"
}

install_self() {
  local src
  src=$(readlink -f "$0")
  [[ $src == /usr/local/bin/netban ]] || install -m 755 "$src" /usr/local/bin/netban
  perm_file_init
  if command -v systemctl >/dev/null && [[ -d /run/systemd/system ]]; then
    cat >"$UNIT_FILE" <<'EOF'
[Unit]
Description=netban - restore permanent nftables network bans
Documentation=file:///usr/local/bin/netban
After=nftables.service
PartOf=nftables.service
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/netban restore
ExecReload=/usr/local/bin/netban restore

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable --now netban.service >/dev/null
    echo "installed /usr/local/bin/netban, $PERM_FILE, netban.service (enabled)"
  else
    echo "installed /usr/local/bin/netban and $PERM_FILE"
    echo "no systemd: run 'netban restore' at boot (rc.local, cron @reboot, ...)"
  fi
}

usage() { awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0"; }

interactive() {
  echo "netban — type a network to ban it (default $DEFAULT_DUR)."
  echo "commands: <net> [dur|perm] [note] | unban <net> | list | restore | purge | help | quit"
  local line cmd arg1 rest
  while read -r -e -p "netban> " line; do
    [[ -z $line ]] && continue
    history -s "$line"
    read -r cmd arg1 rest <<<"$line"
    case $cmd in
      q|quit|exit) break ;;
      l|ls|list) list ;;
      u|unban) unban "${arg1:-}" ;;
      restore) restore ;;
      purge) purge ;;
      h|help|\?) usage ;;
      b|ban) read -r a b <<<"${rest:-}"; ban "${arg1:-}" "${a:-}" "${b:-}" ;;
      *) ban "$cmd" "${arg1:-}" "${rest:-}" ;;
    esac
  done
}

# -------------------------------------------------------------------- main
case "${1:-}" in
  "") interactive ;;
  -l|--list|list) list ;;
  -u|--unban|unban) unban "${2:-}" ;;
  restore|--restore) restore ;;
  --purge|purge) purge ;;
  --install|install) install_self ;;
  -h|--help|help) usage ;;
  *) ban "$1" "${2:-}" "${*:3}" ;;
esac
